{
  "manifest_version": 3,
  "name": "SkipIt",
  "version": "0.1.0",
  "description": "Automatically activates visible YouTube Skip Ad controls when they become available.",
  "action": {
    "default_title": "SkipIt",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://youtube-nocookie.com/*",
    "*://www.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://youtube-nocookie.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
